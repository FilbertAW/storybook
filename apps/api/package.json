{
  "name": "@storylib/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=.env src/db/cli.ts seed",
    "db:setup": "tsx --env-file-if-exists=.env src/db/cli.ts setup",
    "build": "node scripts/build-vercel.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.0.0",
    "@hono/zod-validator": "^0.7.0",
    "@libsql/client": "^0.18.0",
    "@storylib/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": "22.x"
  }
}
