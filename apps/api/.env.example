PORT=8787
CORS_ORIGIN=http://localhost:5173
# Local SQLite file in dev; a libsql:// URL plus token for Turso in production.
DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=
# At least 32 characters. Use a long random value in production.
JWT_SECRET=dev-only-secret-change-before-deploying-0123456789
# Dev only: mounts GET/POST /api/v1/dev/clock to shift time and demo subscription expiry.
ENABLE_DEV_CLOCK=false
